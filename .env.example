PORT=3000
SESSION_SECRET=ganti-dengan-string-acak-yang-panjang

# Ambil dari dashboard.midtrans.com (Settings > Access Keys)
# Gunakan kredensial SANDBOX dulu untuk testing
MIDTRANS_SERVER_KEY=SB-Mid-server-xxxxxxxxxxxxxxxxxxxx
MIDTRANS_CLIENT_KEY=SB-Mid-client-xxxxxxxxxxxxxxxxxxxx
MIDTRANS_IS_PRODUCTION=false
# Metode yang tampil di popup: hanya QRIS + Virtual Account. Kosongkan untuk semua metode.
MIDTRANS_ENABLED_PAYMENTS=other_qris,bca_va,bni_va,bri_va,permata_va,cimb_va,other_va

APP_URL=http://localhost:3000
